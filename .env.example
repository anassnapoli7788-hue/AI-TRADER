# =====================================================================
# AI Trading Desk — environment example. Copy to .env and fill values.
# NEVER commit .env. NEVER paste real keys into chat or the Settings UI.
# =====================================================================

# Only needed if you switch the provider to "openai_compatible" in Settings.
# The default provider (opencode_cli) needs NO API key: it reuses the
# providers already configured inside your OpenCode Desktop installation.
#
# Example: set this to the NAME of the env var holding your API key, then
# define that env var here or in your shell profile:
#   In Settings -> Model Provider -> "API key environment variable NAME": TRADING_DESK_API_KEY
#   In this file:
#     TRADING_DESK_API_KEY=your-nvidia-or-deepseek-or-glm-key-here
TRADING_DESK_API_KEY=

# --- KILO CODE provider ---
# Real key supplied by the operator. Set KILO_BASE_URL only if KILO CODE is
# a direct OpenAI-compatible endpoint rather than accessed via OpenCode Desktop.
KILO_API_KEY=your-kilo-api-key-here
# KILO_BASE_URL=https://api.kilo-code.example.com/v1

# --- OpenRouter provider ---
# Aggregates many model families (Anthropic Claude, Meta Llama, etc.)
# Set OPENROUTER_API_KEY to use OpenRouter models via the openai_compat provider.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama provider ---
# Local Ollama (http://localhost:11434/v1) needs no key by default.
# Set OLLAMA_BASE_URL only if running a remote Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: change listening port (must match the frontend proxy in dev mode)
# TRADING_DESK_PORT=8765
